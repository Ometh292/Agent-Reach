# Agent Reach Configuration
# Copy to .env and fill in your values
# Or use: agent-reach configure

# Exa Search (free 1000/month) — https://exa.ai
# EXA_API_KEY=exa-your-key-here

# GitHub Token (optional, for higher rate limits) — https://github.com/settings/tokens
# GITHUB_TOKEN=ghp_your_token_here

# Reddit ISP Proxy (optional, for full Reddit access)
# REDDIT_PROXY=http://user:pass@ip:port

# Groq Whisper (optional, for video transcription) — https://console.groq.com
# GROQ_API_KEY=gsk_your_key_here

# OpenAI Whisper (optional fallback when Groq is rate-limited) — https://platform.openai.com
# OPENAI_API_KEY=sk-your_key_here

# ── Hosted client application (agent_reach.webserver) ──────────────────────
# Only needed when running the client-facing web app, not the CLI.
# Find these in the Supabase dashboard under Settings → API.

# Project URL, e.g. https://abcdefgh.supabase.co
# SUPABASE_URL=

# "anon / public" key. Safe to serve to the browser — it identifies the
# project and is useless without a valid session.
# SUPABASE_ANON_KEY=

# Optional. The project's JWT Secret. When set, sessions are verified locally
# with no network round-trip. Without it the server asks Supabase on each new
# token instead, which also works. NEVER send this to the browser.
# SUPABASE_JWT_SECRET=

# Optional. NEVER put this in frontend code and never send it to a browser:
# it bypasses Row Level Security entirely. Not required by this application.
# SUPABASE_SERVICE_ROLE_KEY=

# Optional. Raises GitHub search from 60 to 5000 requests/hour. A token with
# no scopes is enough.
# GITHUB_TOKEN=

# Optional. Enables the Transcribe feature. Without it the tab is hidden.
# Every transcription spends this key, so keep RATE_LIMIT_TRANSCRIBE low.
# GROQ_API_KEY=

# Optional. Comma-separated origins allowed to call the API cross-origin.
# Leave empty when the frontend is served by this same app (the default).
# ALLOWED_ORIGINS=

# Optional rate limits, as requests/seconds. Defaults shown.
# RATE_LIMIT_SEARCH=60/3600
# RATE_LIMIT_READ=60/3600
# RATE_LIMIT_BROWSE=60/3600
# RATE_LIMIT_YOUTUBE=30/3600
# RATE_LIMIT_TRANSCRIBE=3/3600
